# Copy this file to .env and adjust values for your environment.

ENVIRONMENT=development
DEBUG=true

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# Local/dev (SQLite, zero setup):
DATABASE_URL=sqlite:///./storage/app.db
# Production (PostgreSQL) - uncomment and edit:
# DATABASE_URL=postgresql+psycopg2://sales_bi_user:strong_password@localhost:5432/sales_bi

# --- Redis (optional) ---
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50

LOG_LEVEL=INFO
MODEL_RETRAIN_CRON=0 2 * * *
